{
  "name": "daybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:design": "node scripts/lint-design.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "digest": "node --env-file-if-exists=.env.local --import tsx scripts/digest.ts",
    "digest:install": "node --env-file-if-exists=.env.local --import tsx scripts/digest-install.ts",
    "digest:uninstall": "node --import tsx scripts/digest-install.ts --uninstall",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs",
    "test:clock": "node scripts/test-clock.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "detect:diff": "node --import tsx scripts/detect-diff.ts",
    "backtest:pace": "node --import tsx scripts/backtest-pace.ts",
    "plans:confirm": "node --import tsx scripts/confirm-plans.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.4.0",
    "next": "16.2.6",
    "nodemailer": "^10.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
